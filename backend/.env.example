# ==============================================================
# CodeTrack Backend Environment Variables
# ==============================================================

# Server Environment (development / production)
NODE_ENV=development
PORT=5000

# MongoDB Connection String
# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/codetrack
# Production (MongoDB Atlas):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/codetrack?retryWrites=true&w=majority

# Client Application URL for CORS
# Local:
CLIENT_URL=http://localhost:5173
# Production (comma-separated supported for Vercel):
# CLIENT_URL=https://your-frontend.vercel.app,http://localhost:5173

# JWT Authentication (e.g. 30d for 30 days, or 365d for 1 year)
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=30d

# Live Platform Scraper Service (fallback)
CODING_PROFILE_SERVICE_URL=https://coding-profile-service-v2-0.onrender.com